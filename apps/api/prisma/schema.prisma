generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH & USERS
// ==========================================
model User {
  id            Int       @id @default(autoincrement())
  nome          String
  email         String    @unique
  senha         String    // bcrypt hash
  role          String    // gerencia, tecnico, recepcao, financeiro, cliente
  ativo         Boolean   @default(true)
  clienteId     Int?      // Se role=cliente, vincula ao Cliente
  primeiroAcesso Boolean  @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cliente       Cliente?  @relation(fields: [clienteId], references: [id])
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  favoritos     ServicoFavorito[]
  ordensResponsavel OrdemServico[] @relation("OSResponsavel")
  etapasResponsavel EtapaOS[]      @relation("EtapaResponsavel")

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
}

// Papel de acesso. `nome` é o slug usado em User.role e nos guards.
// Os 4 papéis do sistema (gerencia/recepcao/tecnico/financeiro) têm sistema=true
// (não podem ser excluídos nem ter o slug alterado). Gerência é superadmin.
model Papel {
  id        Int      @id @default(autoincrement())
  nome      String   @unique // slug: gerencia, recepcao, tecnico, financeiro, ou custom
  label     String
  descricao String?
  sistema   Boolean  @default(false)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissoes PapelPermissao[]

  @@index([nome])
}

// Permissão concedida a um papel. `chave` referencia o catálogo de áreas
// definido em código (permissoes.catalog.ts).
model PapelPermissao {
  id      Int    @id @default(autoincrement())
  papelId Int
  chave   String

  papel Papel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  @@unique([papelId, chave])
  @@index([papelId])
}

// ==========================================
// M01 — CADASTRO DE CLIENTES
// ==========================================
model Cliente {
  id                Int       @id @default(autoincrement())
  tipo              String    // PJ ou PF
  nome              String    // Razão Social (PJ) ou Nome completo (PF)
  nomeFantasia      String?   // "Apelido" no legado (ex: INDAP)
  documento         String    @db.Text  // CPF/CNPJ criptografado AES-256
  inscricaoEstadual String?   // IE (PJ)
  idEtiqueta        String?   // Código curto usado nas etiquetas físicas (cassete/lâmina)
  email             String    // E-mail principal
  emailFinanceiro   String?   // E-mail principal para faturas/boletos
  emailsCobranca    String[]  @default([]) // e-mails adicionais de cobrança
  emailMacroscopia  String?   // E-mail para aprovação de macroscopia
  telefone          String?
  celular           String?
  segmento          String    @default("recorrente") // recorrente, esporadico, pesquisador
  projeto           String?   // nº/código do projeto de financiamento (FAPESP/CNPq) — sai na NF (pesquisador)
  // Cobrança programada (Cora): quando ligada, o sistema gera a cobrança do mês
  // fechado automaticamente no dia escolhido. Default desligada (emissão manual).
  cobrancaAutomatica Boolean  @default(false)
  diaCobranca        Int?     // dia do mês (1–28) para gerar a cobrança automática
  descontoPadrao    Decimal   @default(0) @db.Decimal(5, 2) // desconto fixo recorrente (%) aplicado a todo pedido deste cliente
  portalToken       String?   @unique // token do link público do portal do cliente (sem login)
  observacoes       String?   @db.Text
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  enderecos     Endereco[]
  contatos      Contato[]
  tabelaPrecos  TabelaPreco[]
  pedidos       Pedido[]
  orcamentos    Orcamento[]
  faturas       Fatura[]
  users         User[]
  creditos      CreditoPrePago[]
  contratos     Contrato[]

  @@index([documento])
  @@index([nome])
}

// Contrato de mensalidade fixa (valor recorrente por mês, independente do
// consumo). Início + duração definem o vencimento; renovar soma a duração.
// A cobrança da mensalidade é separada do fechamento por consumo.
model Contrato {
  id            Int       @id @default(autoincrement())
  clienteId     Int
  valorMensal   Decimal   @db.Decimal(10, 2)
  dataInicio    DateTime
  duracaoMeses  Int       // ex.: 12
  dataFim       DateTime  // = dataInicio + duracaoMeses (recalculado ao renovar)
  diaCobranca   Int       // dia do mês (1–28) para gerar a cobrança da mensalidade
  ativo         Boolean   @default(true)
  observacoes   String?   @db.Text
  ultimaCobrancaEm DateTime? // controle da geração mensal (fase 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@index([ativo])
  @@index([dataFim])
}

model Endereco {
  id         Int     @id @default(autoincrement())
  clienteId  Int
  tipo       String  @default("entrega") // entrega, cobranca, sede
  logradouro String
  numero     String
  complemento String?
  bairro     String
  cidade     String
  uf         String  @db.Char(2)
  cep        String  @db.Char(9)
  principal  Boolean @default(false)

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
}

model Contato {
  id        Int     @id @default(autoincrement())
  clienteId Int
  nome      String
  cargo     String?
  email     String?
  telefone  String?
  principal Boolean @default(false)

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
}

model TabelaPreco {
  id        Int     @id @default(autoincrement())
  clienteId Int
  servicoId Int
  preco     Decimal @db.Decimal(10, 2)
  desconto  Decimal @default(0) @db.Decimal(5, 2) // percentual

  cliente Cliente @relation(fields: [clienteId], references: [id])
  servico Servico @relation(fields: [servicoId], references: [id])

  @@unique([clienteId, servicoId])
}

// ==========================================
// SERVIÇOS (tabela base)
// ==========================================
model Servico {
  id            Int     @id @default(autoincrement())
  codigo        String  @unique         // código string (ex: "374" do legado ou custom)
  codigoLegado  Int?    @unique         // código numérico do sistema legado
  categoria     String  @default("Outros") // Macroscopia, IHQ, Citologia, etc.
  nome          String
  descricao     String? @db.Text
  precoBase     Decimal @db.Decimal(10, 2) // = precoRotina (compatibilidade)
  precoRotina   Decimal @default(0)    @db.Decimal(10, 2)
  precoPesquisa Decimal @default(0)    @db.Decimal(10, 2)
  observacoes   String? @db.Text
  ativo         Boolean @default(true)
  geraEtiqueta  Boolean @default(true) // se o serviço gera etiqueta (ex.: "caixa corta-lâmina" = false)
  prazoDias     Int     @default(1) // prazo de entrega padrão (dias úteis); 1 = 24h
  // Campos para seleção guiada (cascata)
  tipo          String? // Eppendorf, Histológico, Microdissecção, etc.
  variante1     String? // Lâmina Silanizada, Material Ósseo, Em Resina, etc.
  variante2     String? // 1º Nível, 2º Nível, Seriado, etc.
  variante3     String? // 2 vezes, 4 vezes, 5 vezes, 6 vezes, etc.
  variante4     String? // 50 micras, 20 micras, 10 micras, etc.
  variante5     String? // Com HE, Com HE + Finalização, etc.

  tabelaPrecos   TabelaPreco[]
  itensPedido    ItemPedido[]
  itensOrcamento ItemOrcamento[]
  favoritos      ServicoFavorito[]
  pacoteItens    PacoteItem[]
  amostras       Amostra[]

  @@index([codigo])
  @@index([categoria])
  @@index([codigoLegado])
  @@index([tipo])
}

// ==========================================
// PACOTES (combos de serviços com preço próprio)
// ==========================================
model Pacote {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nome        String
  descricao   String?  @db.Text
  // Como o preço é calculado quando o pacote é usado num pedido:
  //  'fixo'     → usa PacoteItem.preco (preço fechado do combo)
  //  'desconto' → aplica PacoteItem.descontoPct sobre o preço atual do cliente
  tipoPreco   String   @default("fixo")
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itens       PacoteItem[]

  @@index([codigo])
  @@index([ativo])
}

model PacoteItem {
  id          Int     @id @default(autoincrement())
  pacoteId    Int
  servicoId   Int
  quantidade  Int     @default(1)
  preco       Decimal @db.Decimal(10, 2) // preço fixo do componente (modo 'fixo')
  descontoPct Decimal @default(0) @db.Decimal(5, 2) // % desconto sobre a tabela (modo 'desconto')

  pacote  Pacote  @relation(fields: [pacoteId], references: [id], onDelete: Cascade)
  servico Servico @relation(fields: [servicoId], references: [id])

  @@index([pacoteId])
  @@index([servicoId])
}

model ServicoFavorito {
  id        Int      @id @default(autoincrement())
  userId    Int
  servicoId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  servico Servico @relation(fields: [servicoId], references: [id])

  @@unique([userId, servicoId])
  @@index([userId])
}

// ==========================================
// M02 — PEDIDOS
// ==========================================
model Pedido {
  id            Int       @id @default(autoincrement())
  clienteId     Int
  numero        String    @unique // PED-20260410-001 (referência interna completa)
  seq           Int?      @unique // código curto sequencial p/ exibição (ex.: 42 → "#0042")
  status        String    @default("rascunho")
  origem        String    @default("local") // local (interno) | web (portal do cliente)
  urgente            Boolean  @default(false) // prioridade do pedido
  pagamentoAdiantado Boolean  @default(false) // já pago/adiantado (não cobrar no fechamento)
  qtdPrevista   Int?      // qtd de amostras prevista (conferência no recebimento)
  qtdRecebida   Int?      // qtd de amostras efetivamente recebida
  excedente     Boolean   @default(false) // recebeu mais que o previsto → verificar cobrança
  prazoDias     Int?      // prazo de entrega acordado no orçamento (dias úteis)
  dataEnvio     DateTime?
  dataRecepcao  DateTime? // entrada registrada na recepção (etapa 1)
  dataRecebimento DateTime?
  observacoes   String?   @db.Text // observação interna (não visível ao cliente)
  contagemDivergente Boolean @default(false) // gate de aprovação quando recebido ≠ orçado
  // Orçamento arquivado (não virou pedido): especulador, desistiu, recusado…
  motivoArquivo String?   // motivo do arquivamento (só quando status=arquivado)
  dataArquivo   DateTime? // quando foi arquivado
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cliente  Cliente      @relation(fields: [clienteId], references: [id])
  itens    ItemPedido[]
  amostras Amostra[]
  creditos CreditoPrePago[]
  recipientes Recipiente[]
  laudos Laudo[]
  comunicacoes Comunicacao[]

  @@index([clienteId])
  @@index([numero])
  @@index([status])
}

// ── Recebimento etapa 1 (Recepção): recipientes que chegaram, sem contar amostras
model TipoRecipiente {
  id     Int     @id @default(autoincrement())
  nome   String  @unique
  ativo  Boolean @default(true)
  ordem  Int     @default(0)
}

model Recipiente {
  id          Int      @id @default(autoincrement())
  pedidoId    Int
  tipo        String   // Pote, Caixa, Saco, Outro, …
  quantidade  Int      @default(1)
  codigo      String?  @unique // conteúdo do código de barras da etiqueta do recipiente (Recepção)
  etiquetaImpressa Boolean @default(false)
  observacoes String?
  recebidoPor String?
  createdAt   DateTime @default(now())

  pedido   Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  amostras Amostra[] // amostras designadas dentro do recipiente (Laboratório)

  @@index([pedidoId])
}

model ItemPedido {
  id        Int     @id @default(autoincrement())
  pedidoId  Int
  servicoId Int
  quantidade Int    @default(1)
  preco     Decimal @db.Decimal(10, 2)
  desconto  Decimal @default(0) @db.Decimal(5, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id])
  servico Servico @relation(fields: [servicoId], references: [id])
  amostra Amostra? // amostra gerada a partir deste item (emissão de etiquetas)

  @@index([pedidoId])
}

// ==========================================
// M03 — RECEBIMENTO E RASTREABILIDADE
// ==========================================
model Amostra {
  id              Int       @id @default(autoincrement())
  pedidoId        Int
  recipienteId    Int?      // recipiente de origem (Pote/Caixa/Saco) designado no Laboratório
  itemPedidoId    Int?      @unique // item de origem (quando criada via emissão de etiquetas)
  servicoId       Int?      // serviço solicitado ao qual esta amostra/cassete pertence (macroscopia)
  numeroInterno   String    @unique // Numeração diária Histocell
  numeroCliente   String?   // Número do cliente (ex: Alquimipet)
  especie         String    // canino, felino, bovino, humano, etc
  material        String    // biópsia, citologia, etc
  localizacao     String?   // região anatômica
  status          String    @default("pendente")
  observacoes     String?   @db.Text
  dataRecebimento DateTime?
  recebidoPor     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pedido          Pedido    @relation(fields: [pedidoId], references: [id])
  recipiente      Recipiente? @relation(fields: [recipienteId], references: [id])
  itemPedido      ItemPedido? @relation(fields: [itemPedidoId], references: [id])
  servico         Servico?  @relation(fields: [servicoId], references: [id])
  ordemServico    OrdemServico?
  etiquetas       Etiqueta[]

  @@index([pedidoId])
  @@index([recipienteId])
  @@index([servicoId])
  @@index([numeroInterno])
  @@index([status])
}

// ==========================================
// M04 — ORDENS DE SERVIÇO (Fluxo Analítico)
// ==========================================
model OrdemServico {
  id          Int       @id @default(autoincrement())
  amostraId   Int       @unique
  numero      String    @unique // OS-20260410-001
  status      String    @default("fila")
  etapaAtual  String    @default("triagem") // triagem, macroscopia, processamento, laudo
  prioridade  String    @default("normal") // urgente, normal
  responsavel String?
  responsavelUserId Int?
  responsavelUser   User?  @relation("OSResponsavel", fields: [responsavelUserId], references: [id])
  observacoes String?   @db.Text
  // Conferência fina: liberada com justificativa mesmo incompleta (trava a expedição)
  conferenciaLiberada Boolean @default(false)
  conferenciaObs      String? @db.Text
  iniciadoEm  DateTime?
  concluidoEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  amostra       Amostra        @relation(fields: [amostraId], references: [id])
  etapas        EtapaOS[]
  laudo         Laudo?

  @@index([status])
  @@index([etapaAtual])
  @@index([responsavelUserId])
}

model EtapaOS {
  id             Int       @id @default(autoincrement())
  ordemServicoId Int
  etapa          String    // triagem, macroscopia, processamento, laudo
  status         String    @default("pendente")
  responsavel    String?
  responsavelUserId Int?
  responsavelUser   User?  @relation("EtapaResponsavel", fields: [responsavelUserId], references: [id])
  observacoes    String?   @db.Text
  iniciadoEm     DateTime?
  concluidoEm    DateTime?

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id])

  @@index([ordemServicoId])
}

model Laudo {
  id              Int       @id @default(autoincrement())
  ordemServicoId  Int?      @unique
  pedidoId        Int?      // laudo ligado ao pedido (caso/cliente)
  conteudo        String?   @db.Text
  macroscopia     String?   @db.Text
  microscopia     String?   @db.Text
  diagnostico     String?   @db.Text
  // Fluxo "por e-mail": patologista externo recebe o pedido por e-mail e
  // devolve o laudo em PDF, que é anexado e liberado ao cliente.
  patologistaNome  String?
  patologistaEmail String?
  arquivoBase64    String?  @db.Text // PDF do laudo (base64)
  arquivoNome      String?
  status           String   @default("solicitado") // solicitado | liberado
  solicitadoPor    String?
  solicitadoEm     DateTime?
  assinadoPor     String?
  assinadoEm      DateTime?
  liberado        Boolean   @default(false)
  liberadoEm      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ordemServico OrdemServico? @relation(fields: [ordemServicoId], references: [id])
  pedido       Pedido?       @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
}

// ==========================================
// M06 — ETIQUETAS
// ==========================================
model Etiqueta {
  id            Int       @id @default(autoincrement())
  amostraId     Int
  numero        Int       @unique // sequencial global (ex: 1384126) — impresso sob o barcode
  codigo        String    @unique // conteúdo do código de barras Code128 (composto: cliente+histocell+lâmina)
  tipo          String    // cassete, lamina, bloco
  coloracao     String?   // ex: ".HE"
  identificacao String?   // linha-topo da etiqueta (ex: "PatoVetLab-DF/01 /M10 1")
  laminaSeq     Int       @default(1) // nº da lâmina/cassete dentro da amostra
  impresso      Boolean   @default(false)
  impressoEm    DateTime?
  createdAt     DateTime  @default(now())
  // ── Rastreio por departamento (scan de código de barras) ──
  departamentoAtual String?   // departamento corrente (recepcao, macroscopia, …)
  rastreioStatus    String    @default("nao_iniciado") // nao_iniciado, em_andamento, aguardando, concluido
  ultimoEventoEm    DateTime?
  ultimoResponsavel String?   // quem fez o último scan
  // Conferência fina (bipagem antes da expedição)
  conferidaEm       DateTime?
  conferidaPor      String?

  amostra Amostra @relation(fields: [amostraId], references: [id])
  eventos RastreioEvento[]

  @@index([codigo])
  @@index([numero])
  @@index([amostraId])
  @@index([impresso])
  @@index([departamentoAtual])
}

// ── Eventos de rastreio: entrada/saída de cada etiqueta nos departamentos ──
model RastreioEvento {
  id           Int      @id @default(autoincrement())
  etiquetaId   Int
  departamento String   // recepcao, macroscopia, processamento, microtomia, coloracao, laudo, expedicao
  tipo         String   // entrada, saida
  scannedPor   String?  // operador/estação que escaneou
  observacoes  String?
  createdAt    DateTime @default(now())

  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@index([etiquetaId])
  @@index([departamento])
  @@index([createdAt])
}

// ==========================================
// M07 — QUALIDADE
// ==========================================
model RegistroQualidade {
  id           Int      @id @default(autoincrement())
  tipo         String   // nao_conformidade, acao_corretiva, calibracao
  descricao    String   @db.Text
  status       String   @default("aberto") // aberto, em_andamento, resolvido
  responsavel  String?
  resolucao    String?  @db.Text
  createdAt    DateTime @default(now())
  resolvidoEm  DateTime?
}

// ==========================================
// M08 — COMERCIAL / CRM
// ==========================================
model Orcamento {
  id          Int       @id @default(autoincrement())
  clienteId   Int
  numero      String    @unique // ORC-001
  status      String    @default("rascunho")
  valorTotal  Decimal   @db.Decimal(10, 2)
  desconto    Decimal   @default(0) @db.Decimal(5, 2)
  validade    DateTime
  observacoes String?   @db.Text
  aprovadoPor String?   // quem aprovou desconto (gerencia)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cliente Cliente         @relation(fields: [clienteId], references: [id])
  itens   ItemOrcamento[]
  followUps FollowUp[]

  @@index([clienteId])
  @@index([status])
}

model ItemOrcamento {
  id          Int     @id @default(autoincrement())
  orcamentoId Int
  servicoId   Int
  quantidade  Int     @default(1)
  preco       Decimal @db.Decimal(10, 2)
  desconto    Decimal @default(0) @db.Decimal(5, 2)

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])
  servico   Servico   @relation(fields: [servicoId], references: [id])

  @@index([orcamentoId])
}

model FollowUp {
  id          Int      @id @default(autoincrement())
  orcamentoId Int
  tipo        String   // email, telefone, whatsapp, reuniao
  descricao   String   @db.Text
  createdAt   DateTime @default(now())
  criadoPor   String

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])

  @@index([orcamentoId])
}

// ==========================================
// M09 — FINANCEIRO
// ==========================================
model Fatura {
  id           Int       @id @default(autoincrement())
  clienteId    Int
  numero       String    @unique // FAT-202604-001
  periodo      String    // 2026-04
  valorTotal   Decimal   @db.Decimal(10, 2)
  status       String    @default("pendente") // pendente | emitida | paga | cancelada | erro
  dataEmissao  DateTime  @default(now())
  dataVencimento DateTime
  dataPagamento DateTime?
  observacoes  String?   @db.Text
  // ── Integração de cobrança (Banco Cora) ──────────────────────────────────
  coraInvoiceId  String?  @unique // id do boleto na Cora
  coraStatus     String?  // status do boleto retornado pela Cora
  linhaDigitavel String?
  codigoBarras   String?
  pixQrCode      String?  @db.Text
  pdfUrl         String?
  nfseStatus     String?  // pendente | emitida | erro
  nfseUrl        String?
  erroCobranca   String?  @db.Text // última mensagem de erro da emissão
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  cliente  Cliente       @relation(fields: [clienteId], references: [id])
  itens    ItemFatura[]

  @@unique([clienteId, periodo]) // uma fatura por cliente/mês (evita boleto duplicado)
  @@index([clienteId])
  @@index([status])
  @@index([periodo])
}

model ItemFatura {
  id        Int     @id @default(autoincrement())
  faturaId  Int
  descricao String
  quantidade Int    @default(1)
  valor     Decimal @db.Decimal(10, 2)

  fatura Fatura @relation(fields: [faturaId], references: [id])

  @@index([faturaId])
}

model CreditoPrePago {
  id        Int      @id @default(autoincrement())
  clienteId Int
  pedidoId  Int?     // pedido que originou o débito (consumo automático)
  valor     Decimal  @db.Decimal(10, 2)
  tipo      String   // credito, debito
  descricao String
  saldo     Decimal  @db.Decimal(10, 2) // saldo acumulado após o lançamento
  createdAt DateTime @default(now())

  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  pedido    Pedido?  @relation(fields: [pedidoId], references: [id])

  @@index([clienteId])
  @@index([pedidoId])
}

// ==========================================
// AUDITORIA (LGPD)
// ==========================================
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String   // CREATE, READ, UPDATE, DELETE, LOGIN, EXPORT
  entity    String
  entityId  Int?
  details   String?  @db.Text
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ── Comunicação com o cliente (motivos/ocorrências por setor + notificações) ──
model Motivo {
  id               Int      @id @default(autoincrement())
  setor            String   // recepcao | macroscopia | tecnica | coloracao | expedicao | geral
  titulo           String
  mensagemTemplate String   @db.Text // aceita {cliente} {pedido} {itens} {obs}
  notificaCliente  Boolean  @default(true)
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([setor])
}

model Comunicacao {
  id             Int      @id @default(autoincrement())
  pedidoId       Int?
  ordemServicoId Int?
  setor          String
  tipo           String   // ocorrencia | notificacao_pronto | atraso
  assunto        String
  mensagem       String   @db.Text
  destinatario   String?
  criadoPor      String?
  emailEnviado   Boolean  @default(false)
  emailInfo      String?
  createdAt      DateTime @default(now())

  pedido Pedido? @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
  @@index([ordemServicoId])
}
